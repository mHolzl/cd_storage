

{#####                                        #####}
{##### generate genre "tags" from genre array #####}
{#####                                        #####}
{% macro tag_list(tags) %}
  {% for tag in tags %}
    <span class="genre_tag {{ tag.css_class }}" title=" {{ tag.name }}"><i class="{{ tag.fa_icon  }}"></i> {{ tag.name_ua }}</span>
  {% endfor%}
{% endmacro %}


{#####                                         #####}
{##### generate star ranking from 1 to 5 stars #####}
{#####                                         #####}
{% macro star_ranking(ranking) %}
  <span class="ranking_stars stars-color-{{ ranking }}">
  {% for i in range(1,5) %}
    {% if i <= ranking %}
      <i class="fas fa-star"></i>
    {% else %}
      <i class="far fa-star"></i>
    {% endif %}
  {% endfor %}
  </span>
{% endmacro %}



